{"parentUuid":"243e42f0-09c0-424e-96b6-e27cac34d19f","isSidechain":false,"attachment":{"type":"deferred_tools_record","entries":[{"name":"WebFetch","description":"Fetches a URL, converts the page to markdown, and answers `prompt` against it using a small fast model.\n\n- Fails on authenticated/private URLs — use an authenticated MCP tool or `gh` for those instead. claude.ai artifact links (claude.ai/artifact/{id} or claude.ai/code/artifact/{uuid}) are published artifacts: read them with the Artifact tool (action \"read\"), not WebFetch or curl.\n- Fails on localhost and other hostnames without a dot; for a local server, use curl via Bash.\n- HTTP is upgraded to HTTPS. Cross-host redirects are returned to you rather than followed; call again with the redirect URL.\n- Responses are cached for 15 minutes per URL.","input_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"url":{"description":"The URL to fetch content from","type":"string","format":"uri"},"prompt":{"description":"The prompt to run on the fetched content","type":"string"},"offset":{"description":"Character position in the page text to start reading from. Use it to read on through a page too long for one call, with the value the previous result gave.","type":"integer","minimum":0,"maximum":9007199254740991}},"required":["url","prompt"],"additionalProperties":false},"eager_input_streaming":true,"defer_loading":true},{"name":"mcp__sidecar__audit_screen","description":"Screen-use audit (docs/audit.md): estimate how much of a pane, app or web page is content vs blank, what is clipped or off-screen, which elements are larger than the viewport, and a HEURISTIC chrome-vs-data split (the report names every rule and a confidence; it is a heuristic, not a measurement of value). target=pane asks the browser behind the pane (live; errors with conflict if it is offline); render=true (always on for app and url) measures a headless Chrome render instead and adds pixel coverage. Needs the admin token. Returns the full report, with a short human text in `report`.","input_schema":{"type":"object","properties":{"height":{"description":"render viewport height in css px (give with width)","maximum":16384,"minimum":1,"type":"integer"},"name":{"description":"pane id or app name; for target=url, the http(s) URL (it must be on the server's proxy allow list)","type":"string"},"render":{"description":"measure a headless render instead of the live browser (always for app and url)","type":"boolean"},"scale":{"description":"render UI scale (default: the pane's)","maximum":2.5,"minimum":1,"type":"number"},"target":{"description":"what to audit","enum":["pane","app","url"],"type":"string"},"timeout_s":{"description":"seconds the server waits (default 15)","maximum":60,"minimum":1,"type":"integer"},"width":{"description":"render viewport width in css px (give with height)","maximum":16384,"minimum":1,"type":"integer"}},"required":["target","name"],"additionalProperties":false},"eager_input_streaming":true,"defer_loading":true},{"name":"mcp__sidecar__drive_pane","description":"Drive a pane: switch it to a whitelisted app, or back to its self-describing default view. Needs the admin token. Errors: app_not_allowed, capability_mismatch (e.g. touch app on a non-touch pane), loop, rate_limited.","input_schema":{"type":"object","properties":{"app":{"description":"whitelisted app name (see list_apps); omit when mode is default","type":"string"},"mode":{"description":"\"default\" returns the pane to its self-describing view","enum":["app","default"],"type":"string"},"origin":{"description":"Who is asking, e.g. {kind:\"herdr\", ref:\"workspace=1/pane=3\"}. Defaults to the server's --origin / $SIDECAR_ORIGIN.","properties":{"kind":{"description":"origin kind, lowercase id (herdr, agent, cli, ...)","type":"string"},"label":{"description":"optional human label","type":"string"},"ref":{"description":"origin reference, no commas (workspace=1/pane=3)","type":"string"}},"required":["kind","ref"],"type":"object"},"pane":{"description":"pane id (same as the device id; see list_uis)","type":"string"},"via":{"description":"Loop-prevention chain: the origin keys of whatever caused this call. Pass the chain of the command/request you are acting on behalf of.","items":{"type":"string"},"type":"array"}},"required":["pane"],"additionalProperties":false},"eager_input_streaming":true,"defer_loading":true},{"name":"mcp__sidecar__fullscreen_pane","description":"Maximize a pane (its shell hides its chrome and fills the display) or restore it. Needs the admin token. A browser only enters full screen after a tap on the display, so this always maximizes the layout and shows an \"Enter full screen\" button on the pane when the browser refuses; the result is the wanted state, not proof the browser is in full screen. Errors: not_found, unauthorized.","input_schema":{"type":"object","properties":{"fullscreen":{"description":"true to maximize (default), false to restore","type":"boolean"},"pane":{"description":"pane id (same as the device id; see list_uis)","type":"string"}},"required":["pane"],"additionalProperties":false},"eager_input_streaming":true,"defer_loading":true},{"name":"mcp__sidecar__list_apps","description":"List the whitelisted apps a pane can be driven to.","input_schema":{"type":"object","properties":{},"additionalProperties":false},"eager_input_streaming":true,"defer_loading":true},{"name":"mcp__sidecar__list_devices","description":"List enrolled display devices with viewport, usable rect, orientation, online state and capabilities.","input_schema":{"type":"object","properties":{"online":{"description":"only devices that are (true) or are not (false) online","type":"boolean"},"touch":{"description":"only devices that do (true) or do not (false) have touch","type":"boolean"}},"additionalProperties":false},"eager_input_streaming":true,"defer_loading":true},{"name":"mcp__sidecar__list_uis","description":"List the available UIs: one row per device with capabilities (touch, sse, js), the current app, and the apps it can be driven to. Use this to choose a pane for drive_pane or ask_user.","input_schema":{"type":"object","properties":{"online":{"description":"only devices that are (true) or are not (false) online","type":"boolean"},"touch":{"description":"only devices that do (true) or do not (false) have touch","type":"boolean"}},"additionalProperties":false},"eager_input_streaming":true,"defer_loading":true}]},"type":"attachment","uuid":"c3055908-d28b-4799-9b17-282f52ede85e","timestamp":"2026-10-19T17:27:28.188Z","session_id":"3b59b3ab-40e2-4906-ae5b-518d2b1a7b53","userType":"external","entrypoint":"cli","cwd":"/Users/trilliumsmith/fm_home/firstmate","sessionId":"3b59b3ab-40e2-4906-ae5b-518d2b1a7b53","version":"2.1.293","gitBranch":"main","slug":"floating-tinkering-lemur"}
