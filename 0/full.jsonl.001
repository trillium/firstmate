     ]\n65\t      }\n66\t    ],\n67\t    \"PreToolUse\": [\n68\t      {\n69\t        \"matcher\": \"Bash|Write|Edit|MultiEdit|NotebookEdit\",\n70\t        \"hooks\": [\n71\t          {\n72\t            \"type\": \"command\",\n73\t            \"command\": \"/Users/trilliumsmith/.bun/bin/bun /Users/trilliumsmith/code/behavioral-hooks/dispatchers/PreToolUse.dispatcher.hook.ts\"\n74\t          }\n75\t        ]\n76\t      }\n77\t    ],\n78\t    \"PostToolUse\": [\n79\t      {\n80\t        \"hooks\": [\n81\t          {\n82\t            \"type\": \"command\",\n83\t            \"command\": \"/Users/trilliumsmith/.bun/bin/bun /Users/trilliumsmith/code/behavioral-hooks/dispatchers/PostToolUse.dispatcher.hook.ts\"\n84\t          }\n85\t        ]\n86\t      },\n87\t      {\n88\t        \"matcher\": \"Bash\",\n89\t        \"hooks\": [\n90\t          {\n91\t            \"type\": \"command\",\n92\t            \"command\": \"/Users/trilliumsmith/.bun/bin/bun /Users/trilliumsmith/fm_home/firstmate/projects/fm-hooks/src/claude-hook.ts\"\n93\t          }\n94\t        ]\n95\t      }\n96\t    ],\n97\t    \"PostToolUseFailure\": [\n98\t      {\n99\t        \"matcher\": \"Bash\",\n100\t        \"hooks\": [\n101\t          {\n102\t            \"type\": \"command\",\n103\t            \"command\": \"/Users/trilliumsmith/.bun/bin/bun /Users/trilliumsmith/fm_home/firstmate/projects/fm-hooks/src/claude-hook.ts\"\n104\t          }\n105\t        ]\n106\t      }\n107\t    ]\n108\t  },\n109\t  \"skipDangerousModePermissionPrompt\": true,\n110\t  \"switchModelsOnFlag\": false,\n111\t  \"counts\": {\n112\t    \"skills\": 1,\n113\t    \"skillsPublic\": 1,\n114\t    \"skillsPrivate\": 0,\n115\t    \"workflows\": 0,\n116\t    \"hooks\": 9,\n117\t    \"signals\": 1,\n118\t    \"files\": 0,\n119\t    \"work\": 0,\n120\t    \"sessions\": 231,\n121\t    \"research\": 0,\n122\t    \"ratings\": 1,\n123\t    \"updatedAt\": \"2026-10-19T19:31:22.997Z\"\n124\t  }\n125\t}\n126\t\n</system-reminder>"}],"renderedRo