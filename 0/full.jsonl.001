lt\nembeddeddolt-20261018\nMon Oct 19 09:09:39 PDT 2026","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"31bdd48f-c393-42dc-b170-afc4d0872db9","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"3b59b3ab-40e2-4906-ae5b-518d2b1a7b53","userType":"external","entrypoint":"cli","cwd":"/Users/trilliumsmith/fm_home/firstmate","sessionId":"3b59b3ab-40e2-4906-ae5b-518d2b1a7b53","version":"2.1.293","gitBranch":"main","slug":"floating-tinkering-lemur"}
